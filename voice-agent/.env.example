# D.O.T. AI Lead Assistant Phase 2B — Spyro Fans voice agent ("Meera").
# Copy to .env and fill in real values locally. Never commit .env.

# Sarvam AI — https://dashboard.sarvam.ai/ (API Keys section).
SARVAM_API_KEY=
# Streaming STT model — see https://docs.sarvam.ai/api/getting-started/models/saaras
SARVAM_STT_MODEL=saaras:v3
# Chat completion model used to generate Meera's replies. "sarvam-m" is
# deprecated by Sarvam (HTTP 400) — use sarvam-105b-conversations instead.
SARVAM_LLM_MODEL=sarvam-105b-conversations
# Streaming TTS model — see https://docs.sarvam.ai/api/getting-started/models/bulbul
SARVAM_TTS_MODEL=bulbul:v3
# Phase 2B is English-only (en-IN) — do not change without also updating
# prompts.py's guardrails; multilingual support is Phase 2C.
SARVAM_LANGUAGE=en-IN
# A Bulbul voice name — see https://docs.sarvam.ai/api/api-guides-tutorials/text-to-speech/voices
SARVAM_VOICE=anushka

# This process's own bind address/port.
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8000

# Where this service is publicly reachable from Exotel — must match what's
# configured in the Exotel dashboard Flow's Voicebot Applet (or
# EXOTEL_FLOW_URL on the DailyOps backend). Used here only for startup
# logging, not for any behavior decision. For local development, point
# this at a secure tunnel URL (see README.md) — never commit a real tunnel
# URL.
VOICE_AGENT_WEBSOCKET_URL=wss://your-tunnel-or-domain/ws/exotel

# Hard cap on call length for the Phase 2B test conversation (seconds).
# After this, Meera delivers the closing line and ends the call
# regardless of how the conversation is going.
VOICE_AGENT_MAX_CALL_SECONDS=120

# D.O.T. call-result write-back. After each answered call the agent submits
# the result to DailyOps (POST /api/v1/telephony/voice-agent/call-results),
# identified by Exotel's CallSid — never by searching leads by phone number.
# Authenticated with a shared service key (NOT an employee login): set
# VOICE_AGENT_SERVICE_KEY to the SAME value as the DailyOps backend's own
# VOICE_AGENT_SERVICE_KEY (32+ characters, e.g. `openssl rand -hex 32`;
# never commit it). Leave either variable blank to skip result submission
# entirely — the live call/Exotel/STT/LLM/TTS pipeline is unaffected.
# DAILYOPS_API_USERNAME / DAILYOPS_API_PASSWORD are no longer used.
# No trailing slash, no /api/v1 suffix.
DAILYOPS_API_BASE_URL=http://localhost:4000
VOICE_AGENT_SERVICE_KEY=
