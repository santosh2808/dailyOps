DATABASE_URL="postgresql://dailyops:dailyops@localhost:5432/dailyops?schema=public"
JWT_SECRET="supersecretjwtkey_change_me"
JWT_EXPIRES_IN="1d"
PORT=4000

# Uploaded files (Lead Site Visit photos). REQUIRED in TEST/production: the
# container's disk is not writable by the app and is wiped on every deploy.
# One private bucket per environment; files go under
# s3://<bucket>/lead-site-visit-photos/<username>/<leadId>/<uuid>.<ext>. Credentials come
# from the ECS task role in AWS (AWS_PROFILE / ~/.aws locally). Leave
# FILE_STORAGE_BUCKET empty locally to use LEAD_SITE_VISIT_PHOTOS_DIR instead.
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=
# Optional S3-compatible endpoint (e.g. a local MinIO for testing). Never set
# in AWS.
FILE_STORAGE_ENDPOINT=
# Local development only (used when FILE_STORAGE_BUCKET is empty). Defaults
# to <backend working dir>/uploads/lead-site-visit-photos.
LEAD_SITE_VISIT_PHOTOS_DIR=

# Outgoing email (Quotation/Sales Order/Proforma Invoice/JEO/Tax Invoice
# sends, and Website Form Submission notifications below). Without
# SMTP_HOST set, sends stay "Simulated" (logged to Email History, never
# actually delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Default "To" address for JEO factory notifications when the Resend to
# Factory dialog's Recipient Email field is left blank.
FACTORY_NOTIFICATION_EMAIL=

# Default CC on Proforma Invoice / Tax Invoice sends (in addition to the
# always-on DEFAULT_CC_EMAILS in src/mailer/default-cc-emails.ts).
FINANCE_TEAM_EMAIL=

# Website Form Submissions / Enquiries — comma-separated allowlist of
# origins allowed to call POST /api/v1/public/forms/:publicFormKey/submissions
# from a browser (e.g. the marketing website itself). Leave unset to reject
# all browser-based cross-origin calls by default (fail-closed).
PUBLIC_FORM_CORS_ORIGINS=

# Content image bucket
CONTENT_MEDIA_BUCKET=
CONTENT_MEDIA_REGION=
CONTENT_MEDIA_PUBLIC_BASE_URL=

# Fallback recipient for the internal "new enquiry" notification email, used
# only when neither the form nor its website has a supportEmail configured.
ENQUIRY_NOTIFICATION_EMAIL=

# Public base URLs used to build links embedded in outgoing messages (the
# Quotation Customer Acceptance link, and WhatsApp document share links
# below). In production these are typically different domains behind a
# reverse proxy — FRONTEND_URL for the React app, BACKEND_PUBLIC_URL for
# this API server. Safe to leave unset in local dev (defaults to
# localhost:5173 / localhost:<PORT>).
FRONTEND_URL=
BACKEND_PUBLIC_URL=

# Override Approval workflow — replaces the old self-declare "Approved By"
# dropdown on the Sales Order dispatch / Proforma Invoice advance / JEO
# production-start below-threshold gates with a real blocking email
# approval sent to Santosh and/or Amarpal. Without these set, the gate
# still blocks the action (no self-declare bypass exists anymore), but no
# email goes out — set at least one so the approver actually gets notified.
APPROVER_SANTOSH_EMAIL=
APPROVER_AMAR_EMAIL=
# Days an approval link stays valid before auto-expiring (same convention
# as QUOTATION_LINK_EXPIRY_DAYS). Defaults to 14 if unset.
APPROVAL_LINK_EXPIRY_DAYS=14

# WhatsApp Share (Interakt integration) — sends Quotation/Proforma
# Invoice/Tax Invoice documents directly to the customer's WhatsApp via
# Interakt's WhatsApp Business API. Without INTERAKT_API_KEY set, sends
# stay "Simulated" (logged only, nothing goes out) — same convention as
# SMTP_HOST above. Get the API key from Interakt dashboard > Settings >
# API & Integration Setup; requires a Growth plan or above (message-send
# APIs are not available on the Starter plan).
INTERAKT_API_KEY=
# Language code used for all templates below (Interakt/Meta template
# language, e.g. "en"). Defaults to "en" if unset.
INTERAKT_TEMPLATE_LANGUAGE=

# Each of the 3 document types sends via its own WhatsApp template. These
# must be pre-created (or synced from Meta Business Manager) and APPROVED
# in the Interakt dashboard before use — sending an unrecognized/unapproved
# name fails the send. Defaults shown below match the code's fallback
# names; only set these if you name your templates differently. Suggested
# template body (3 variables, {{1}} name / {{2}} document number / {{3}}
# link) for each, to submit for Meta approval:
#   "Hi {{1}}, please find your quotation {{2}} from SRM here: {{3}}"
#   "Hi {{1}}, please find your proforma invoice {{2}} from SRM here: {{3}}"
#   "Hi {{1}}, please find your tax invoice {{2}} from SRM here: {{3}}"
# (A JEO is no longer shared with the customer — see the JEO factory
# WhatsApp settings further below.)
INTERAKT_QUOTATION_TEMPLATE_NAME=quotation_share
INTERAKT_PROFORMA_INVOICE_TEMPLATE_NAME=proforma_invoice_share
INTERAKT_TAX_INVOICE_TEMPLATE_NAME=tax_invoice_share

# Sent to a Sales Executive/Manager's own WhatsApp number when a Lead is
# assigned to them (separate from the 3 customer-facing document templates
# above). Suggested template body (5 variables, {{1}} assignee name / {{2}}
# lead number / {{3}} company / {{4}} contact person / {{5}} contact phone)
# to submit for Meta approval:
#   "Hi {{1}}, lead {{2}} ({{3}}) has been assigned to you. Contact: {{4}}, {{5}}"
INTERAKT_LEAD_ASSIGNED_TEMPLATE_NAME=lead_assigned

# Sent to a Lead's assigned salesperson on the morning of its scheduled
# Next Follow-up date (LeadFollowUpReminderService's daily @Cron job — see
# leads/lead-followup-reminder.service.ts). Same 5-variable shape as the
# Lead Assigned template above; needs its own separate template name
# submitted for Meta approval on the Interakt dashboard before WhatsApp
# reminders will actually send (email reminders work immediately via
# SMTP/LEAD_FOLLOWUP_REMINDER above, no Interakt approval needed):
#   "Hi {{1}}, reminder to follow up on lead {{2}} ({{3}}) today. Contact: {{4}}, {{5}}"
INTERAKT_LEAD_FOLLOWUP_REMINDER_TEMPLATE_NAME=lead_followup_reminder

# Customer-facing counterpart to the reminder above — sent to the customer
# themselves the moment a Lead moves into the Site Visit stage with a date
# set (LeadsService.notifySiteVisitScheduled(), via updateStatus()), not on
# a daily schedule. Needs its own separate template approved on Interakt:
#   "Hi {{1}}, your site visit for {{2}} has been scheduled for {{3}}."
INTERAKT_SITE_VISIT_SCHEDULED_TEMPLATE_NAME=site_visit_scheduled

# QA feature (SC-013): sent to the customer alongside the matching email
# (SalesOrdersService.notifyCustomerStatusChange()) for every
# customer-relevant Sales Order status change — Confirmed, Production
# Started, Ready for Dispatch, Dispatched, Completed, Cancelled. One shared
# template for all six (status name passed as {{3}}) rather than six
# separate Meta-approval submissions. Needs its own separate template
# approved on Interakt:
#   "Hi {{1}}, your Sales Order {{2}} is now {{3}}."
INTERAKT_SALES_ORDER_STATUS_TEMPLATE_NAME=sales_order_status_update

# AiSensy WhatsApp (replaces Interakt once approved). Off unless
# WHATSAPP_PROVIDER=aisensy; any other value, or unset, keeps the Interakt
# behaviour above. Even then, a document share only sends for real when
# AISENSY_API_KEY AND that share's campaign below are both set — otherwise
# it is simulated (logged and recorded, nothing sent). Set the API key only
# as an ECS secret, never in Git or the frontend.
#
# Each campaign value is the exact name of a Live API campaign in AiSensy,
# built on an approved template with exactly 3 variables:
#   {{1}} customer name / {{2}} document number / {{3}} document link
# The four automatic notifications (lead assigned, follow-up reminder, site
# visit scheduled, sales order status) have no AiSensy campaign setting on
# purpose: under AiSensy they stay simulated until a separately approved
# code change enables them.
WHATSAPP_PROVIDER=
AISENSY_API_KEY=
AISENSY_QUOTATION_SHARE_CAMPAIGN=
AISENSY_PROFORMA_INVOICE_SHARE_CAMPAIGN=
AISENSY_TAX_INVOICE_SHARE_CAMPAIGN=

# JEO factory WhatsApp — sent automatically when a JEO is generated (and
# again on Resend to Factory) to the factory's own people, never to the
# customer. Comma-separated "Name:number" entries, at most 10, e.g.
# "Krishna:9876543210,Ravi:9123456780" — each gets their own message
# (WhatsApp groups can't be messaged through the API). The campaign is a
# Live AiSensy API campaign on an approved template with exactly 5
# variables: {{1}} JEO number / {{2}} sales order number / {{3}} customer
# / {{4}} priority / {{5}} JEO PDF link. Sends for real only when
# WHATSAPP_PROVIDER=aisensy, AISENSY_API_KEY and both of these are set. On
# TEST, list only testers' own numbers.
FACTORY_WHATSAPP_RECIPIENTS=
AISENSY_JEO_FACTORY_CAMPAIGN=

# D.O.T. AI Lead Assistant Phase 2A — Telephony Test Foundation. NEVER
# defaults to active outbound calling in any environment — EXOTEL_ENABLED
# must be explicitly set to "true" (development, staging, AND production)
# before the "Make Test Call" button on Administration -> Telephony Test
# does anything but return "Telephony integration is currently disabled."
# No automated/Lead-triggered calling reads this flag — only an admin
# clicking that one button does.
EXOTEL_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# The Exophone (virtual number) Exotel dials from / displays as caller ID.
EXOTEL_CALLER_ID=
# Only needed for a non-default Exotel region (e.g. Singapore cluster).
# Leave unset to use https://api.exotel.com.
EXOTEL_BASE_URL=
# An Exotel App Bazaar Flow URL, already configured in the Exotel dashboard
# with a Voicebot Applet pointing at VOICE_AGENT_WEBSOCKET_URL below. Exotel
# does not accept a raw WebSocket URL on the Calls API directly — this Flow
# is where that wiring lives. Leave unset to place a plain connect-only test
# call (rings the phone, no voice agent attached) — useful for proving the
# DailyOps -> Exotel -> phone leg on its own before wiring up the bot.
EXOTEL_FLOW_URL=
# Where DailyOps's own callback endpoint is reachable from the public
# internet — Exotel POSTs call status updates here. Must be a real public
# HTTPS URL in staging/production (e.g.
# https://api.yourdomain.com/api/v1/telephony/callback/exotel-status); for
# local development, use a secure tunnel (see Phase 2A docs) rather than
# committing a temporary ngrok URL here.
TELEPHONY_STATUS_CALLBACK_URL=
# Off by default (Step 13 — recording is never mandatory for the first
# test). If enabled, Exotel's own recording URL is stored as a reference
# only (TelephonyTestCall.recordingRef) — the audio itself is never
# downloaded or stored in PostgreSQL.
EXOTEL_RECORDING_ENABLED=false

# Sarvam (STT/LLM/TTS for the isolated voice-agent service — see
# docs/voice-agent-architecture.md). Not called from this NestJS backend in
# Phase 2A; these exist so the voice-agent service (wherever it's deployed)
# can read the same convention. SARVAM_ENABLED off by default.
SARVAM_ENABLED=false
SARVAM_API_KEY=

# The isolated voice-agent service's public WebSocket endpoint (see
# docs/voice-agent-architecture.md) — referenced by the Exotel Flow
# configured at EXOTEL_FLOW_URL above, not called directly by this backend.
# Example: wss://voice-agent.smartrotamac.com/ws
VOICE_AGENT_WEBSOCKET_URL=

# Google Places Autocomplete (New) — upgrades the Billing/Shipping Address
# search box on the Sales Order form from free OpenStreetMap Nominatim to
# Google's address data. Without GOOGLE_PLACES_API_KEY set (the default),
# the Google search box simply doesn't appear and the existing free
# Nominatim search + India Post PIN code lookup keep working exactly as
# before — same "Future Ready" convention as INTERAKT_API_KEY/SMTP_HOST
# above. See backend/src/places/places.service.ts.
#
# To get a key: Google Cloud Console -> create/select a project -> enable
# billing -> APIs & Services -> Library -> enable "Places API (New)" ->
# Credentials -> Create API Key -> restrict it to "Places API (New)" only
# (API restrictions), and ideally also restrict by server IP address
# (Application restrictions) since this key is used server-side only and
# never reaches the browser. Free usage: 70,000 Autocomplete Requests and
# 70,000 Place Details Essentials calls per month (India pricing) — well
# above what an internal sales-order form would use; see
# https://developers.google.com/maps/billing-and-pricing/pricing-india.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Automatic lead intake from ad platforms (see docs/AD_LEAD_INTEGRATION.md).
# Leave blank to keep an integration off — its webhook then answers 503.
# ---------------------------------------------------------------------------
# Meta (Facebook/Instagram) lead ads
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Google Ads lead form webhook key
GOOGLE_LEADS_WEBHOOK_KEY=
