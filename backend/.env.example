DATABASE_URL="postgresql://dailyops:dailyops@localhost:5432/dailyops?schema=public"
JWT_SECRET="supersecretjwtkey_change_me"
JWT_EXPIRES_IN="1d"
PORT=4000

# Outgoing email (Quotation/Sales Order/Proforma Invoice/JEO/Tax Invoice
# sends). Without SMTP_HOST set, sends stay "Simulated" (logged to Email
# History, never actually delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Default "To" address for JEO factory notifications when the Resend to
# Factory dialog's Recipient Email field is left blank.
FACTORY_NOTIFICATION_EMAIL=

# Default CC on Proforma Invoice / Tax Invoice sends (in addition to the
# always-on DEFAULT_CC_EMAILS in src/mailer/default-cc-emails.ts).
FINANCE_TEAM_EMAIL=
