DATABASE_URL="postgresql://dailyops:dailyops@localhost:5432/dailyops?schema=public"
JWT_SECRET="supersecretjwtkey_change_me"
JWT_EXPIRES_IN="1d"
PORT=4000

# Outgoing email (Quotation/Sales Order/Proforma Invoice/JEO/Tax Invoice
# sends, and Website Form Submission notifications below). Without
# SMTP_HOST set, sends stay "Simulated" (logged to Email History, never
# actually delivered).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Default "To" address for JEO factory notifications when the Resend to
# Factory dialog's Recipient Email field is left blank.
FACTORY_NOTIFICATION_EMAIL=

# Default CC on Proforma Invoice / Tax Invoice sends (in addition to the
# always-on DEFAULT_CC_EMAILS in src/mailer/default-cc-emails.ts).
FINANCE_TEAM_EMAIL=

# Website Form Submissions / Enquiries — comma-separated allowlist of
# origins allowed to call POST /api/v1/public/forms/:publicFormKey/submissions
# from a browser (e.g. the marketing website itself). Leave unset to reject
# all browser-based cross-origin calls by default (fail-closed).
PUBLIC_FORM_CORS_ORIGINS=

# Fallback recipient for the internal "new enquiry" notification email, used
# only when neither the form nor its website has a supportEmail configured.
ENQUIRY_NOTIFICATION_EMAIL=

# Public base URLs used to build links embedded in outgoing messages (the
# Quotation Customer Acceptance link, and WhatsApp document share links
# below). In production these are typically different domains behind a
# reverse proxy — FRONTEND_URL for the React app, BACKEND_PUBLIC_URL for
# this API server. Safe to leave unset in local dev (defaults to
# localhost:5173 / localhost:<PORT>).
FRONTEND_URL=
BACKEND_PUBLIC_URL=

# WhatsApp Share (Interakt integration) — sends Quotation/Proforma
# Invoice/Tax Invoice/JEO documents directly to the customer's WhatsApp via
# Interakt's WhatsApp Business API. Without INTERAKT_API_KEY set, sends
# stay "Simulated" (logged only, nothing goes out) — same convention as
# SMTP_HOST above. Get the API key from Interakt dashboard > Settings >
# API & Integration Setup; requires a Growth plan or above (message-send
# APIs are not available on the Starter plan).
INTERAKT_API_KEY=
# Language code used for all templates below (Interakt/Meta template
# language, e.g. "en"). Defaults to "en" if unset.
INTERAKT_TEMPLATE_LANGUAGE=

# Each of the 4 document types sends via its own WhatsApp template. These
# must be pre-created (or synced from Meta Business Manager) and APPROVED
# in the Interakt dashboard before use — sending an unrecognized/unapproved
# name fails the send. Defaults shown below match the code's fallback
# names; only set these if you name your templates differently. Suggested
# template body (3 variables, {{1}} name / {{2}} document number / {{3}}
# link) for each, to submit for Meta approval:
#   "Hi {{1}}, please find your quotation {{2}} from SRM here: {{3}}"
#   "Hi {{1}}, please find your proforma invoice {{2}} from SRM here: {{3}}"
#   "Hi {{1}}, please find your tax invoice {{2}} from SRM here: {{3}}"
#   "Hi {{1}}, please find your job execution order {{2}} from SRM here: {{3}}"
INTERAKT_QUOTATION_TEMPLATE_NAME=quotation_share
INTERAKT_PROFORMA_INVOICE_TEMPLATE_NAME=proforma_invoice_share
INTERAKT_TAX_INVOICE_TEMPLATE_NAME=tax_invoice_share
INTERAKT_JEO_TEMPLATE_NAME=jeo_share
