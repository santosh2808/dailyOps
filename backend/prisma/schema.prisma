generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  // Legacy free-text role label — left in place and still populated/returned
  // exactly as before (see AuthService/JwtStrategy) so nothing that already
  // reads it breaks. Real authorization now flows through `roles` below
  // (UserRole -> Role -> RolePermission -> Permission), never through this
  // string.
  role      String   @default("admin")
  createdAt DateTime @default(now())

  // Additive for Enterprise RBAC.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  isActive     Boolean     @default(true)
  updatedAt    DateTime    @updatedAt

  // Login credential alongside `email` — AuthService accepts either as the
  // login identifier (see LoginDto). Always stored lowercased, same
  // convention as `email`.
  username String @unique

  // Set to true whenever an Administrator resets this user's password (or
  // when the user is first created); cleared only by the user successfully
  // completing POST /auth/change-password themselves. ProtectedRoute on the
  // frontend redirects to /change-password for as long as this is true,
  // regardless of what URL is requested.
  mustChangePassword Boolean @default(false)

  // Additive: Lead Assignment enhancement. Optional contact number, shown
  // on the quick "+ Add User" flow used from the Lead Assignment picker.
  phone String?

  // Back-relation for Lead.assignedToUserId below — a User can have many
  // Leads assigned to them.
  assignedLeads Lead[]
}

// Enterprise RBAC — additive models only; nothing above this comment was
// restructured. A user can hold multiple Roles (UserRole is the join table);
// a Role can hold multiple Permissions (RolePermission is the join table).
// Authorization is always resolved as the union of permissions across every
// Role a user currently holds — there is no special-cased "admin" bypass
// anywhere in guard/service code. The Administrator role simply gets every
// Permission row assigned to it via RolePermission at seed time, like any
// other role.
model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  // Additive: Sales Automation Approval Matrix — a Role can be the required
  // approver for zero or more ApprovalMatrix brackets (see that model).
  approvalMatrixEntries ApprovalMatrix[]
}

// One row per (module, action) — e.g. (Lead, View), (Quotation, Approve).
// `code` is the lowercased "module.action" string that the backend
// PermissionsGuard and the frontend hasPermission(module, action) helper
// both match against; `module`/`action` are kept as their own columns (as
// specified) for display in the Permissions/Role screens.
model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  phone         String
  email         String?
  gstNumber     String?
  // Dashboard Redesign v2 — India Sales Map. One of the 36 Indian
  // states/UTs (see frontend INDIA_STATES / backend indiaStates.ts for the
  // exact list this is validated against). Required at the
  // CreateCustomerDto layer so every customer always shows up on the map;
  // column stays nullable for the handful of customers created before this
  // was enforced. Sales Orders don't have their own state field — they're
  // mapped to a state through this, via their Customer.
  state         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Back-relations required by Prisma for Quotation.customer,
  // SalesOrder.customer, ProformaInvoice.customer, and
  // JobExecutionOrder.customer. Additive only — no existing Customer fields,
  // validation, or behavior changed.
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  proformaInvoices    ProformaInvoice[]
  jobExecutionOrders  JobExecutionOrder[]

  // Additive: automated GST Tax Invoice (see TaxInvoice below).
  taxInvoices         TaxInvoice[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String
  sku         String?
  description String?
  price       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Additive: Sales Automation price validation (requirement #8). All three
  // are optional — a product created before this feature (or one that's
  // simply never had its price floor/ceiling set) behaves exactly as before:
  // no minimum-price or discount-bracket check ever fires for it (see
  // QuotationsService's price validation gate).
  standardPrice      Float?
  minPrice           Float?
  maxDiscountPercent Float?

  // Additive: Techno-Commercial Offer PDF (branded Quotation template).
  // Every field the Annexure-I "Scope of Supply | Technical Specifications"
  // table needs, for whichever fan size/model this Product row represents
  // (e.g. "SPYRO 14"). A single flexible JSON blob rather than ~25 flat
  // columns — same convention already used for AuditLog.oldValue/newValue —
  // since this is purely descriptive spec-sheet data with no query/filter
  // requirement of its own. Optional: a product with this unset simply
  // renders a spec table with blank values rather than blocking PDF
  // generation. Shape (all fields optional strings unless noted):
  //   modelNo, fanSize, noOfBlades, airVolume, coverageArea, motorRating,
  //   speed, noise, weight, threePhaseVoltage, threePhaseCurrent,
  //   onePhaseVoltage, onePhaseCurrent, frequency, frameStructure,
  //   hangingStructure, fasteners, bladeDesign, bladeMoc,
  //   bladeSectionalWidth, driveType, controlPanelMounting,
  //   controlPanelDrive, controlPanelEnclosure, bmsCompatibility,
  //   safetyCertification, boltedJoints, warrantyMotor, warrantyDrive,
  //   warrantyOther, scopeOfSupply: { item: string; quantityPerFan: string }[]
  technicalSpec      Json?

  // Back-relations required by Prisma for LeadProduct.product,
  // QuotationItem.product, and SalesOrderItem.product. Additive only — no
  // existing Product fields, validation, or behavior changed.
  leadProducts     LeadProduct[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]
}

// Lead Management Phase 1 — replaced wholesale per the new required
// workflow (Create -> Assign -> Contacted -> Site Visit -> Qualified ->
// Quotation Sent -> Won/Lost). NEGOTIATION and NOT_INTERESTED are dropped;
// the hand-authored migration remaps any existing rows (NEGOTIATION ->
// QUOTATION_SENT, NOT_INTERESTED -> LOST) rather than losing data.
enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  SITE_VISIT
  QUALIFIED
  QUOTATION_SENT
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  REFERENCE
  TRADE_SHOW
  COLD_CALL
  DISTRIBUTOR
  WALK_IN
  EMAIL
  PHONE
  OTHER
}

model Lead {
  id                String       @id @default(uuid())
  leadNumber        String       @unique
  // Set only by LeadsService.convertToCustomer() when a WON lead is
  // converted. Plain scalar (no Customer relation) — consistent with how
  // this schema avoids cross-module FKs unless Prisma requires one.
  customerId        String?
  companyName       String
  contactPerson     String
  designation       String?
  email             String?
  phone             String
  alternatePhone    String?
  title             String
  description       String?
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  source            LeadSource   @default(OTHER)
  estimatedValue    Float?
  expectedCloseDate DateTime?
  nextFollowUp      DateTime?
  // Lead Management Phase 1 (requirement #5) — a short free-text reminder
  // note attached to the next follow-up (e.g. "Call before 3pm"). The
  // Today's/Overdue/Upcoming Follow-up widgets are still purely date-driven
  // off `nextFollowUp` above; this is just displayed alongside it, not used
  // in any query.
  reminderNote      String?
  // Lead Assignment enhancement: a real FK to User (Enterprise RBAC's User
  // model didn't exist yet when Lead was first designed, hence this being
  // a relation now rather than the plain scalar convention used elsewhere).
  // SetNull on delete — if the assigned user is ever removed, the lead just
  // becomes unassigned rather than blocking the delete. Required at the
  // CreateLeadDto layer (every new lead must be assigned to someone); the
  // column stays String? because onDelete: SetNull requires a nullable FK.
  assignedToUserId  String?
  assignedToUser    User?        @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  city              String?
  // Required at the CreateLeadDto layer — validated against INDIA_STATES so
  // it always carries through to Customer.state on conversion (see
  // LeadsService.convertToCustomer()) and shows up on the Dashboard's India
  // Sales Map. Column stays nullable for leads created before this was
  // enforced.
  state             String?
  country           String?
  // Additive column for the Lead Import feature — the import template's
  // "Industry" column has no home in the pre-existing field list, and
  // silently dropping user-provided data on import would be unprofessional.
  // Nullable/optional everywhere (manual Lead creation via the form still
  // works unchanged without it).
  industry          String?
  remarks           String?
  isConverted       Boolean      @default(false)
  convertedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  products          LeadProduct[]

  // Additive: Lead History/Notes/Assignment/Status audit trail. Every row
  // is append-only (created, never updated/deleted) and cascades away if
  // the parent Lead is ever hard-deleted (soft delete via deletedAt never
  // triggers this).
  history           LeadHistory[]
  notes             LeadNote[]
  assignmentHistory LeadAssignmentHistory[]
  statusHistory     LeadStatusHistory[]
  // Lead Management Phase 1 (requirement #8) — Quotations generated
  // directly from a Lead before it's been converted to a Customer. Unlike
  // the customerId-join synthesis used elsewhere in this schema, this is a
  // real FK because a lead-originated Quotation has no Customer to join
  // through yet (that conversion is explicitly out of scope this phase).
  quotations        Quotation[]

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([assignedToUserId])
  @@index([deletedAt])
}

// Tracks every action listed in the Lead History requirement. "Quotation
// Created" is deliberately NOT persisted here — Quotation has no FK back to
// Lead (see Quotation model comment), so LeadsService synthesizes those
// entries at read time by joining on Lead.customerId once a lead has been
// converted, rather than adding a cross-module write into the Quotations
// module.
enum LeadHistoryAction {
  CREATED
  EDITED
  ASSIGNED
  STATUS_CHANGED
  QUOTATION_CREATED
  CUSTOMER_CONVERTED
  // Additive: Sales Automation workflow (requirement #1). Like
  // QUOTATION_CREATED above, these are synthesized at read time in
  // LeadsService.getHistory() by walking Lead.customerId -> Quotation(s) ->
  // SalesOrder -> ProformaInvoice/JobExecutionOrder — never written directly
  // — but are real enum values so the synthesized rows are type-correct.
  QUOTATION_SENT
  SALES_ORDER_CREATED
  PROFORMA_INVOICE_GENERATED
  JEO_GENERATED
  // Additive: Lead Management Phase 1 (requirement #3). Unlike the four
  // above, these ARE written directly by LeadsService — see addNote() and
  // the follow-up branch of update().
  NOTE_ADDED
  FOLLOWUP_ADDED
  // Additive: Customer Quotation Acceptance workflow — written directly by
  // LeadsService.recordQuotationAccepted()/recordQuotationRejected() when
  // the customer decides via the secure public quotation link.
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
}

model LeadHistory {
  id          String            @id @default(uuid())
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action      LeadHistoryAction
  description String
  // Actor display name captured from the authenticated request at the time
  // of the action (same convention as SalesOrder.createdBy) — never
  // accepted from the request body.
  performedBy String?
  createdAt   DateTime          @default(now())

  @@index([leadId])
  @@index([action])
}

// Free-text notes a user can add to a lead — unlimited, append-only, never
// edited or deleted through the API.
model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note      String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadAssignmentHistory {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousUser String?
  newUser      String?
  changedBy    String?
  createdAt    DateTime @default(now())

  @@index([leadId])
}

model LeadStatusHistory {
  id        String     @id @default(uuid())
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus LeadStatus?
  newStatus LeadStatus
  remarks   String?
  changedBy String?
  createdAt DateTime   @default(now())

  @@index([leadId])
}

model LeadProduct {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  unitPrice Float?
  remarks   String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([productId])
}

enum QuotationStatus {
  DRAFT
  // Additive: Sales Automation Quotation workflow (requirement #6) — sits
  // between DRAFT and SENT, marking pricing as reviewed/finalized and ready
  // to go out. Purely a status value; no behavior is keyed off it other
  // than being selectable via the existing PATCH .../status endpoint.
  READY
  SENT
  // Additive: Customer Quotation Acceptance workflow — set the moment the
  // customer opens the secure public link (see
  // QuotationsService.recordPublicView()). Never set any other way, and
  // never regressed back to SENT.
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  // Lead Management Phase 1 (requirement #8/#9): a Quotation can now be
  // generated directly from a QUALIFIED Lead, before any Customer exists —
  // "Generate Quotation" must NOT trigger Customer conversion this phase.
  // customerId is therefore nullable; exactly one of customerId/leadId is
  // set at creation (enforced in QuotationsService.create(), not the DB).
  // When Phase 2's Customer Acceptance eventually converts the lead, that
  // step is expected to backfill customerId onto any of its quotations —
  // leadId is never cleared, so the originating lead stays traceable.
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  status          QuotationStatus @default(DRAFT)
  subtotal        Float           @default(0)
  gstPercent      Float           @default(18)
  gstAmount       Float           @default(0)
  // Additive: real currency amounts (not just Annexure-II descriptive text)
  // that feed into grandTotal. installationCharge defaults to Rs.8,000 per
  // fan (auto-computed from item quantities at create/update time) unless a
  // quotation explicitly overrides it; transportationCharge has no sensible
  // default — it varies by site/distance and is filled in by staff per
  // quotation, defaulting to 0 until set. GST is charged on
  // subtotal + installationCharge + transportationCharge (see
  // QuotationsService.computeTotals()).
  installationCharge   Float @default(0)
  transportationCharge Float @default(0)
  grandTotal      Float           @default(0)
  // Additive: Techno-Commercial Offer PDF — Annexure-II commercial terms
  // (price basis, GST Included/Extra wording, transportation, payment,
  // delivery, offer validity, optional unloading/installation-schedule
  // lines, and an optional regionCode inserted into quotationNumber at
  // creation) turned out to genuinely vary order to order rather than being
  // fixed boilerplate — see QuotationPdfService's QuotationCommercialTerms.
  // Optional: a quotation with this unset just renders the PDF with the
  // service's sensible defaults, exactly like Product.technicalSpec.
  commercialTerms Json?
  validUntil      DateTime?
  notes           String?
  terms           String?
  // Additive: Send Quotation (requirement #6). Populated by
  // QuotationsService.sendQuotation() the moment an email actually goes
  // out (or is at least attempted) — never set any other way, and never
  // cleared once set (a quotation can be re-sent, which just overwrites
  // these with the latest send).
  sentAt          DateTime?
  sentBy          String?
  sentToEmail     String?
  // Additive: Customer Quotation Acceptance workflow — the secure public
  // link is /quote/{publicToken}, generated fresh every time
  // sendQuotation() runs (see QuotationsService). Nullable: a quotation
  // that has never been sent has no token yet. Never exposes the
  // quotation's own database id.
  publicToken     String?         @unique
  tokenExpiresAt  DateTime?
  // View tracking (requirement #7) — updated by
  // QuotationsService.recordPublicView() on every GET of the public link,
  // regardless of how many times it's opened.
  firstViewedAt   DateTime?
  lastViewedAt    DateTime?
  viewCount       Int             @default(0)
  // Customer Acceptance (requirement #4) — set together, exactly once, by
  // QuotationsService.acceptViaPublicLink(). "Customer" is always the
  // recorded actor for the accompanying AuditLog/QuotationHistory entry,
  // not a User — there is deliberately no login for the customer side of
  // this workflow.
  acceptedAt              DateTime?
  acceptedByName          String?
  acceptedByDesignation   String?
  acceptanceComment       String?
  // Customer Rejection (requirement #5) — set together, exactly once, by
  // QuotationsService.rejectViaPublicLink().
  rejectedAt              DateTime?
  rejectionReason         String?
  rejectionComment        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  items           QuotationItem[]

  // Back-relation required by Prisma for SalesOrder.quotation. Additive
  // only — a Quotation doesn't otherwise know about the Sales Order module.
  salesOrder SalesOrder?

  // Back-relation required by Prisma for JobExecutionOrder.quotation.
  // Additive only — same pattern as `salesOrder` above.
  jobExecutionOrders JobExecutionOrder[]

  // Additive: Sales Automation — Email History (requirement #7/#12) and the
  // Price Validation / Approval Matrix escalation flow (requirements #8/#9).
  emailHistory      EmailHistory[]
  approvalRequests  QuotationApprovalRequest[]

  @@index([status])
  @@index([customerId])
  @@index([leadId])
  @@index([deletedAt])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  description String?
  quantity    Int       @default(1)
  unitPrice   Float      @default(0)
  lineTotal   Float      @default(0)
  createdAt   DateTime  @default(now())

  @@index([quotationId])
  @@index([productId])
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PRODUCTION_STARTED
  READY_FOR_DISPATCH
  DISPATCHED
  COMPLETED
  CANCELLED
}

// The Sales Order is the central business document in DailyOps: it is
// created only from an ACCEPTED Quotation (enforced in
// SalesOrdersService.create(), not at the schema level), and is the anchor
// point for downstream documents. Proforma Invoice and JEO (Job Execution
// Order, the production-floor document, below) are both generated from a
// Sales Order this same way. Still to come: Material Planning / BOM,
// Production Tracking, and Dispatch — see the doc comment on
// JobExecutionOrder for how those are designed to slot in without a
// database change.
// No PDF generation is implemented yet — this comment only documents that
// extension point per "Future Ready" scope (see ProformaInvoice below).
model SalesOrder {
  id                  String           @id @default(uuid())
  salesOrderNumber    String           @unique
  quotationId         String           @unique
  quotation           Quotation        @relation(fields: [quotationId], references: [id])
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id])
  orderDate           DateTime         @default(now())
  deliveryDate        DateTime?
  paymentTerms        String?
  advancePercentage   Float?
  status              SalesOrderStatus @default(DRAFT)
  subtotal            Float            @default(0)
  discount            Float            @default(0)
  tax                 Float            @default(0)
  grandTotal          Float            @default(0)
  billingAddress      String?
  shippingAddress     String?
  specialInstructions String?
  remarks             String?
  // Plain scalar (the authenticated user's name from the JWT payload) — no
  // enforced User relation, consistent with how Lead.assignedTo avoids a
  // cross-module FK to the Users module.
  createdBy           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  items               SalesOrderItem[]

  // Additive: Dispatch gate (advance-payment check). Populated only when a
  // user overrides the "advance not received" block on a READY_FOR_DISPATCH
  // / DISPATCHED status change — see SalesOrdersService.updateStatus(). Left
  // null on every normal transition (advance already received, or the
  // status isn't a dispatch one), and reset back to null the next time a
  // dispatch-related transition succeeds without needing an override, so a
  // stale note never lingers once the underlying situation is resolved.
  dispatchOverrideNote String?
  dispatchOverrideBy    String?
  dispatchOverrideAt    DateTime?

  // Back-relations required by Prisma for ProformaInvoice.salesOrder and
  // JobExecutionOrder.salesOrder. Additive only — no existing SalesOrder
  // fields, validation, or behavior changed.
  proformaInvoices    ProformaInvoice[]
  jobExecutionOrders  JobExecutionOrder[]

  // Additive: automated GST Tax Invoice (see TaxInvoice below).
  taxInvoices         TaxInvoice[]

  // Additive: Sales Automation Email History (Order Confirmation / Dispatch
  // notifications sent from this Sales Order — see SalesOrdersService).
  emailHistory        EmailHistory[]

  // Additive: Complaints module. A Complaint links to the Sales Order (not
  // directly to Customer) so the customer and any generated Proforma
  // Invoice are both reached through this one relation — see Complaint's
  // own comment.
  complaints          Complaint[]

  @@index([status])
  @@index([customerId])
  @@index([quotationId])
  @@index([deletedAt])
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  description  String?
  quantity     Int        @default(1)
  unitPrice    Float      @default(0)
  discount     Float      @default(0)
  tax          Float      @default(0)
  lineTotal    Float      @default(0)

  @@index([salesOrderId])
  @@index([productId])
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  EXPIRED
  CANCELLED
}

// A Proforma Invoice is always machine-generated from an existing
// SalesOrder (ProformaInvoicesService.create()): customer, and amounts
// (subtotal/discount/tax/grandTotal) are copied at generation time and
// never re-entered by hand. There is intentionally no ProformaInvoiceItem
// table — line items are not duplicated; they are read through the
// `salesOrder` relation (salesOrder.items) for display, since this exact
// field list didn't call for a separate item table. One consequence: the
// displayed item list follows the live Sales Order, not a frozen snapshot
// (unlike subtotal/discount/tax/grandTotal, which ARE snapshotted columns).
//
// Future Ready: PDF generation (Smart Rotamac's existing Proforma Invoice
// layout) is intentionally NOT implemented here — no layout is hardcoded.
// The natural extension point is a `GET /api/v1/proforma-invoices/:id/pdf`
// endpoint added to ProformaInvoicesController, backed by a
// ProformaInvoicesService.renderPdf(id) method that loads this row (already
// including everything the layout needs: invoice/customer/amounts/bank
// details, plus salesOrder.items for line items) and feeds it into a PDF
// templating step — added later without touching this model.
model ProformaInvoice {
  id            String                @id @default(uuid())
  invoiceNumber String                @unique
  salesOrderId  String
  salesOrder    SalesOrder            @relation(fields: [salesOrderId], references: [id])
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id])
  invoiceDate   DateTime              @default(now())
  validUntil    DateTime?
  subtotal      Float                 @default(0)
  discount      Float                 @default(0)
  tax           Float                 @default(0)
  grandTotal    Float                 @default(0)
  // Additive: PDF generation (Proforma Invoice layout) — the "Advance
  // received" / "Receivable" rows on the printed invoice. Actual amount
  // received against this invoice, entered by whoever generates it (there
  // is no payment-gateway/ledger integration to derive this automatically
  // from); "Receivable" itself is never stored — it's always computed as
  // grandTotal - advanceReceived at render/read time, same convention as
  // every other derived total in this schema.
  advanceReceived Float               @default(0)
  paymentTerms  String?
  bankName      String?
  accountNumber String?
  ifscCode      String?
  branch        String?
  notes         String?
  status        ProformaInvoiceStatus @default(DRAFT)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Additive: Sales Automation Email History (requirement #12 — Proforma
  // Invoice is emailed to the customer, CC Finance, on generation).
  emailHistory  EmailHistory[]

  @@index([status])
  @@index([salesOrderId])
  @@index([customerId])
}

enum TaxInvoiceStatus {
  DRAFT
  SENT
  CANCELLED
}

// Automated GST "Tax Invoice" — the legal, final invoice a customer's
// advance payment + dispatch readiness unlocks (see SalesOrdersService's
// dispatch gate and TaxInvoicesService.create()). Distinct from
// ProformaInvoice on purpose: a Proforma Invoice is a non-GST pre-invoice
// used to request the advance; this is the actual Tally-style Tax Invoice
// (CGST/SGST or IGST breakdown, HSN/SAC-wise tax table, UDYAM/CIN/PAN,
// three printed copies) that used to be generated by hand in Tally and
// emailed manually — see TaxInvoicePdfService. Same "generated from Sales
// Order, snapshotted totals, no ItemInvoice table" convention as
// ProformaInvoice: line items are read live through `salesOrder.items`.
//
// `fiscalYear` + `sequenceNumber` exist alongside the human-readable
// `invoiceNumber` (format `SRM/{fiscalYear}/{sequenceNumber}`, e.g.
// `SRM/2026-27/135`) purely so the next number in a fiscal year can be
// computed with a numeric MAX() aggregate — the sequence is intentionally
// NOT zero-padded (matching the reference template's "134", not "000134"),
// so sorting the invoiceNumber string itself would give the wrong order.
model TaxInvoice {
  id             String           @id @default(uuid())
  invoiceNumber  String           @unique
  fiscalYear     String
  sequenceNumber Int
  salesOrderId   String
  salesOrder     SalesOrder       @relation(fields: [salesOrderId], references: [id])
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  invoiceDate    DateTime         @default(now())
  // Tally-style dispatch metadata block ("Dispatch Doc No.", "Dispatched
  // through", "Destination", "Terms of Delivery") — free-text, entered once
  // at generation time (there's no separate Dispatch/Logistics module this
  // could be sourced from yet).
  dispatchedThrough String?
  destination       String?
  termsOfDelivery    String?
  buyersOrderNo      String?
  subtotal       Float            @default(0)
  discount       Float            @default(0)
  tax            Float            @default(0)
  grandTotal     Float            @default(0)
  status         TaxInvoiceStatus @default(DRAFT)
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Additive: emailed to the customer on generation, same as ProformaInvoice.
  emailHistory   EmailHistory[]

  @@index([status])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([fiscalYear])
}

// Additive: Complaints module. Links to SalesOrder rather than Customer
// directly — the customer is reached via salesOrder.customer, and any
// generated Proforma Invoice via salesOrder.proformaInvoices, so there's
// exactly one place a complaint is anchored to instead of two relations
// that could disagree. A complaint about a customer with no Sales Order
// yet isn't representable by design; log it once an order exists.
model Complaint {
  id              String          @id @default(uuid())
  complaintNumber String          @unique
  salesOrderId    String
  salesOrder      SalesOrder      @relation(fields: [salesOrderId], references: [id])
  subject         String
  description     String?
  status          ComplaintStatus @default(OPEN)
  // Set when status moves to RESOLVED or CLOSED; cleared if it's reopened.
  resolutionNotes String?
  resolvedAt      DateTime?
  // Plain scalar (the authenticated user's name from the JWT payload) — no
  // enforced User relation, same convention as SalesOrder.createdBy.
  createdBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([status])
  @@index([salesOrderId])
  @@index([deletedAt])
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Scoped to JobExecutionOrder only (not shared with LeadPriority), the same
// way ProformaInvoiceStatus/SalesOrderStatus are each scoped to their own
// model even though the values look similar — keeps this module's priority
// scale independent from Lead's, so a future change to one never silently
// changes the other.
enum JeoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JeoStatus {
  PENDING
  MATERIAL_READY
  ASSEMBLY_STARTED
  QC
  READY_FOR_DISPATCH
  COMPLETED
}

// A Job Execution Order (JEO) is always machine-generated from an existing
// SalesOrder (JobExecutionOrdersService.create()) — never created by typing
// customer/product/quotation details by hand. customerId, quotationId, and
// deliveryDate are copied from the Sales Order at generation time. Like
// ProformaInvoice, there is intentionally no JobExecutionOrderItem table —
// products are not duplicated; they are read through the `salesOrder`
// relation (salesOrder.items) for display. There is also no `deletedAt` on
// this model, per the given field list, so there is no edit/delete
// capability for a JEO at all.
//
// Future Ready: Material Planning / BOM, Production Tracking, and Dispatch
// are all designed to attach to this model via new tables referencing
// `jobExecutionOrderId` (the same additive-FK pattern used throughout this
// schema) — none of that is implemented here, and no columns were added in
// anticipation of it, so today's schema doesn't need to change when those
// modules are eventually built.
model JobExecutionOrder {
  id           String      @id @default(uuid())
  jeoNumber    String      @unique
  salesOrderId String
  salesOrder   SalesOrder  @relation(fields: [salesOrderId], references: [id])
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  quotationId  String
  quotation    Quotation   @relation(fields: [quotationId], references: [id])
  deliveryDate DateTime?
  priority     JeoPriority @default(MEDIUM)
  status       JeoStatus   @default(PENDING)
  // Plain scalar (no User relation) — same convention as Lead.assignedTo
  // and SalesOrder.createdBy; no user-management module exists yet.
  assignedTo   String?
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // One Production Checklist per JEO, created alongside it.
  checklist ProductionChecklist?

  // Additive: Sales Automation Email History (requirement #13 — Production
  // Team / Factory is emailed on generation, with the JEO PDF attached).
  emailHistory EmailHistory[]

  @@index([status])
  @@index([priority])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([quotationId])
}

// Always created together with its JobExecutionOrder (one row each, all
// flags false) — never created standalone. Each boolean is an independently
// toggleable production step; `completedAt` is set once the JEO's status is
// moved to COMPLETED (see JobExecutionOrdersService.updateStatus()), not
// automatically inferred from the booleans, so a supervisor always makes
// the final call rather than the last checkbox silently finishing the job.
model ProductionChecklist {
  id                 String            @id @default(uuid())
  jeoId              String            @unique
  jeo                JobExecutionOrder @relation(fields: [jeoId], references: [id], onDelete: Cascade)
  materialIssued     Boolean           @default(false)
  assemblyStarted    Boolean           @default(false)
  controllerInstalled Boolean          @default(false)
  wiringCompleted    Boolean           @default(false)
  qcPassed           Boolean           @default(false)
  packed             Boolean           @default(false)
  readyForDispatch   Boolean           @default(false)
  completedAt        DateTime?
}

// Additive: State-wise JEO numbering. Each Indian state can have its own
// numbering series (e.g. Telangana JEOs numbered 4000, 4001, 4002...,
// Andhra Pradesh JEOs numbered 5000, 5001...) instead of the original
// global JEO-YYYY-NNNNNN scheme. Configured by an Administrator via
// Administration -> State Series Codes (StateSeriesCodesModule) — states
// with no row here simply keep using the original JEO-YYYY-NNNNNN scheme
// (see JobExecutionOrdersService.generateJeoNumber()), so nothing breaks
// for a state nobody's configured a series for yet, and more states can be
// added later without a code change.
model StateSeriesCode {
  id          String   @id @default(uuid())
  // One of INDIA_STATES (see common/india-states.ts) — validated at the DTO
  // level (CreateStateSeriesCodeDto), not by a DB enum, reusing the same
  // single source of truth as Customer.state/Lead.state.
  state       String   @unique
  seriesStart Int
  // The next number that will be assigned to this state's next JEO —
  // starts equal to seriesStart and is atomically incremented (via a
  // single `UPDATE ... SET "nextNumber" = "nextNumber" + 1` from
  // StateSeriesCodesService.claimNextNumber()) every time a JEO is
  // generated for a customer in this state. Tracking this as a running
  // counter avoids re-parsing every existing JobExecutionOrder.jeoNumber
  // string back into an integer on every single JEO creation (old rows use
  // the JEO-YYYY-NNNNNN format, new ones are plain numbers).
  nextNumber  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Simple lookup table for Material.categoryId — deliberately its own model
// (rather than a free-text field like Product.category) because the
// Material Master spec calls for a "Required Category" validation against
// an actual foreign key, not just a non-empty string.
model MaterialCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  materials   Material[]
}

// Simple lookup table for Material.unitId (e.g. "Kg", "Pcs", "Meter").
model MaterialUnit {
  id        String     @id @default(uuid())
  name      String     @unique
  symbol    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

// The Material Master is a standalone catalog entity, following the same
// isActive-soft-delete convention as Customer/Product (not the
// deletedAt convention used by Lead/Quotation/SalesOrder), since its given
// field list includes `isActive` rather than `deletedAt`.
model Material {
  id           String            @id @default(uuid())
  materialCode String            @unique
  name         String
  description  String?
  categoryId   String
  category     MaterialCategory  @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         MaterialUnit      @relation(fields: [unitId], references: [id])
  // Plain scalars (no Supplier/Warehouse relation) — no Supplier or
  // Warehouse module exists yet in this schema, the same convention already
  // used for Lead.assignedTo / SalesOrder.createdBy / JobExecutionOrder.assignedTo.
  // A future Supplier/Warehouse module could turn these into real relations
  // without renaming either column.
  supplierId   String?
  cost         Float?
  minimumStock Int               @default(0)
  maximumStock Int?
  reorderLevel Int               @default(0)
  currentStock Int               @default(0)
  warehouseId  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([categoryId])
  @@index([unitId])
  @@index([isActive])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

// Supplier Master: a standalone catalog entity, same additive convention as
// Material Master above — Material.supplierId already anticipated this
// module as a plain scalar (not a real relation), so no existing Material
// column changes here. Uses Lead's deletedAt-soft-delete + separate status
// field convention (not Material/Customer's single isActive flag) because
// the given field list calls out "Status" as its own field, distinct from
// whether the record has been deleted.
model Supplier {
  id            String         @id @default(uuid())
  supplierCode  String         @unique
  supplierName  String
  gstNumber     String?
  panNumber     String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String?
  pinCode       String?
  paymentTerms  String?
  // Days until goods/materials arrive after an order is placed.
  leadTime      Int?
  currency      String?
  remarks       String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@index([deletedAt])
}

// ===========================================================================
// Sales Automation (continuation of the DailyOps project) — additive models
// only. Nothing above this line was restructured; every model below is new.
// ===========================================================================

// Editable-by-Administrator email templates (requirement #7). `key` is one
// of a fixed, seeded set (QUOTATION / ORDER_CONFIRMATION / PROFORMA_INVOICE
// / JEO_NOTIFICATION / DISPATCH) that the mailer service looks up by;
// Administrators edit the subject/body of the existing rows rather than
// invent new keys, though the model itself doesn't hardcode the set of keys
// (no enum), so a future template can be added without a schema change.
model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  // Simple {{placeholder}} tokens (e.g. {{customerName}}, {{quotationNumber}})
  // are substituted by MailerService.render() — deliberately not a full
  // templating engine, per "no hardcoding" without over-building.
  bodyHtml  String
  isActive  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only record of every email this system has sent (or attempted to
// send / simulated) — requirement #7/#12/#13/#16 ("Show Email History").
// Exactly one of quotationId/proformaInvoiceId/jobExecutionOrderId/
// salesOrderId is ever populated on a given row (enforced in
// MailerService, not at the schema level) — real foreign keys to whichever
// module triggered the email, per "Do NOT denormalize. Use foreign keys."
model EmailHistory {
  id                  String             @id @default(uuid())
  module              String
  quotationId         String?
  quotation           Quotation?         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  salesOrderId        String?
  salesOrder          SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  proformaInvoiceId   String?
  proformaInvoice     ProformaInvoice?   @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  jobExecutionOrderId String?
  jobExecutionOrder   JobExecutionOrder? @relation(fields: [jobExecutionOrderId], references: [id], onDelete: Cascade)
  // Additive: automated GST Tax Invoice email (see TaxInvoicesService).
  taxInvoiceId        String?
  taxInvoice          TaxInvoice?        @relation(fields: [taxInvoiceId], references: [id], onDelete: Cascade)
  templateKey         String?
  subject             String
  recipientEmail      String
  ccEmails            String?
  // SENT (actually handed to a configured SMTP transport), SIMULATED (no
  // SMTP configured — logged here only, see MailerService), or FAILED.
  status              String
  errorMessage        String?
  sentBy              String?
  sentAt              DateTime           @default(now())

  @@index([quotationId])
  @@index([salesOrderId])
  @@index([proformaInvoiceId])
  @@index([jobExecutionOrderId])
  @@index([taxInvoiceId])
}

// Configurable Approval Matrix engine (requirement #9) — "No hardcoding."
// One row per (module, discount-percent bracket) -> the Role required to
// approve at that bracket. Seeded with the Quotation example from scope
// (0-5% Sales Executive, 5-10% Sales Manager, >10% Administrator), but any
// module name can add its own brackets later and reuse the exact same
// ApprovalMatrixService.resolveRequiredRole(module, percent) engine.
model ApprovalMatrix {
  id           String   @id @default(uuid())
  module       String
  minPercent   Float
  maxPercent   Float
  requiredRoleId String
  requiredRole Role     @relation(fields: [requiredRoleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([module])
}

// Sales rep escalation when a Quotation can't be self-approved — either
// because an item is priced below Product.minPrice (requirement #8's
// "Request Approval" button) or because its discount bracket requires a
// higher role than the requester holds (requirement #9). Deciding a request
// (see QuotationsService.decideApprovalRequest()) performs the ACCEPTED
// transition itself when approved, so the requester doesn't have to
// separately re-click Approve afterwards.
model QuotationApprovalRequest {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy     String?
  requestedAt     DateTime  @default(now())
  reason          String?
  discountPercent Float?
  belowMinPrice   Boolean   @default(false)
  status          String    @default("PENDING")
  decidedBy       String?
  decidedAt       DateTime?
  decisionRemarks String?

  @@index([quotationId])
  @@index([status])
}

// Generic, cross-module audit trail (requirement #15). Deliberately NOT
// foreign-keyed to any single parent table — unlike EmailHistory (which
// always belongs to one of a small, known set of documents), an audit log
// entry can reference literally any record in the system (a Lead, a User, a
// Quotation, a Role, ...), so `module` + `recordId` is a plain descriptive
// pair rather than a real relation. This is the one deliberate exception to
// "use foreign keys" in this schema, and is the standard, conventional shape
// for a system-wide audit log.
model AuditLog {
  id        String   @id @default(uuid())
  module    String
  recordId  String?
  action    String
  actorName String?
  oldValue  Json?
  newValue  Json?
  remarks   String?
  createdAt DateTime @default(now())

  @@index([module])
  @@index([recordId])
  @@index([createdAt])
}
